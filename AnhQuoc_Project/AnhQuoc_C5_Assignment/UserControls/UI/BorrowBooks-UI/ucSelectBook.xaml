<UserControl x:Class="AnhQuoc_C5_Assignment.UserControls.UI.BorrowBooks_UI.ucSelectBook"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnhQuoc_C5_Assignment.UserControls.UI.BorrowBooks_UI"
             xmlns:table="clr-namespace:AnhQuoc_C5_Assignment"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Left: ISBNs table -->
        <GroupBox Grid.Row="0" Header="Book ISBNs" Margin="4" FontSize="15" Padding="10">
            <table:ucBookISBNsTable x:Name="ucBookISBNsTable"
                                    BookISBNDtos="{Binding AllBookISBN}"
                                    MouseDoubleClickEvent="MouseDoubleClick"/>
        </GroupBox>

        <!-- Right: Books table -->
        <GroupBox Grid.Row="1" Header="Selected books" Margin="4" FontSize="15" Padding="10">
            <ListBox x:Name="lstLoanDetail"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding AllLoanDetailCard}">
                <!-- Replace default vertical StackPanel with a WrapPanel -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </GroupBox>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Confirm" Style="{StaticResource btnConfirm}" Click="Confirm_Click"/>
            <Button Content="Cancel" Style="{StaticResource btnCancel}" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
