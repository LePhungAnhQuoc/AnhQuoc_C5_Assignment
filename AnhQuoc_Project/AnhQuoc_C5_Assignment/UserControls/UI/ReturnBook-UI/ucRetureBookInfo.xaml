<UserControl x:Class="AnhQuoc_C5_Assignment.ucRetureBookInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnhQuoc_C5_Assignment"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:behaviors="clr-namespace:AnhQuoc_C5_Assignment.Utilities.Behaviours"
             mc:Ignorable="d" 
             d:DesignWidth="800"
             x:Name="myUserControl">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding BookLoadedCmd}" 
                                   CommandParameter="{Binding ElementName=myUserControl}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <UserControl.Resources>
        <local:PriceFormatConverter x:Key="PriceFormatConverter" />
        <local:BindingProxy x:Key="proxy" Data="{Binding}"/>
        <Style x:Key="txtGeneral" TargetType="TextBox" BasedOn="{StaticResource txtLightBorder}">
            <Setter Property="Width" Value="auto" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Name="gdInputLoanHistory"
          Style="{StaticResource gdContainerForUserControl}"
          Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Add New Loan History"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="#1A1A1A"
                   Margin="0,0,0,15" HorizontalAlignment="Left" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="1" 
        Background="White" 
        BorderBrush="#E2E8F0" 
        BorderThickness="1" 
        CornerRadius="6" 
        Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Bar -->
                    <Border Grid.Row="0" 
                Background="#212529" 
                CornerRadius="5,5,0,0" 
                Padding="12,10">
                        <TextBlock Text="List book of reader" 
                       Foreground="White" 
                       FontWeight="SemiBold" 
                       FontSize="14"/>
                    </Border>

                    <Border Grid.Row="1"
                            Background="White" 
                            CornerRadius="16">
                        <ListBox x:Name="lstUnPaidBooks"
                                 ItemsSource="{Binding AllUnPaidBookCard}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <!-- Remove default ListBox padding/margins and set selection background -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- Selected State (Light Blue Background) -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                    <!-- Hover State -->
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
        Background="#FAFAFA"
        BorderBrush="#E0E0E0"
        BorderThickness="1"
        CornerRadius="6"
        Padding="16">
                <StackPanel Name="stkBookDetailInformation">

                    <!-- Form Field Unit -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Reader:" VerticalAlignment="Center" Foreground="#555555" FontWeight="Medium"/>
                        <TextBox Name="txtReaderName"
                                 Grid.Column="1"
                                 Text="{Binding SelectedReader.FullName, Mode=OneWay}"
                                 Style="{StaticResource txtGeneral}"
                                 IsEnabled="False"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Id Loan:" VerticalAlignment="Center" Foreground="#555555" FontWeight="Medium"/>
                        <TextBox Name="txtIdLoan"
                                 Grid.Column="1"
                                 Text="{Binding SelectedLoanSlip.Id, Mode=OneWay}"
                                 Style="{StaticResource txtGeneral}"
                                 IsEnabled="False"/>
                    </Grid>

                    <!-- Reason Dropdown/Input Container -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Reason:" VerticalAlignment="Center" Foreground="#555555" FontWeight="Medium"/>
                        <ComboBox Grid.Column="1"
                                    Name="cbTxtReason"
                                    Style="{StaticResource cbGeneral}"
                                    DisplayMemberPath="Name"
                                   ItemsSource="{Binding AllReason}"
                                  SelectedIndex="0">
                            <i:Interaction.Triggers>

                                <i:EventTrigger EventName="DropDownClosed">

                                    <i:InvokeCommandAction Command="{Binding BookcbTxtReasonDropDownClosedCmd}" 

                                                                           CommandParameter="{Binding ElementName=cbTxtReason}" />

                                </i:EventTrigger>

                                <i:EventTrigger EventName="SelectionChanged">

                                    <i:InvokeCommandAction Command="{Binding BookcbTxtReasonSelectionChangedCmd}" 

                                                                           CommandParameter="{Binding ElementName=cbTxtReason}" />

                                </i:EventTrigger>

                            </i:Interaction.Triggers>
                        </ComboBox>
                    </Grid>

                    <!-- Fine Amount Field -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Fine amount:" VerticalAlignment="Center" Foreground="#555555" FontWeight="Medium"/>
                        <Grid Grid.Column="1">
                            <TextBox Name="txtFineAmount"
                                     Validation.ErrorTemplate="{StaticResource txtErrorTemplate1}"
                                     Style="{StaticResource txtGeneral}"
                                     IsEnabled="False"
                                     Foreground="Transparent">
                                <TextBox.Text>
                                    <Binding Path="Detail.PaidMoney" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:InputNumberRule />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <TextBlock Style="{StaticResource tblPriceFormat}">
                                <TextBlock.Text>
                                    <Binding 
                                            Path="Detail.PaidMoney"
                                            UpdateSourceTrigger="PropertyChanged" 
                                            Converter="{StaticResource PriceFormatConverter}">
                                    </Binding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- Note Field -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Note:" VerticalAlignment="Center" Foreground="#555555" FontWeight="Medium"/>
                        <TextBox Name="txtNote"
                                 Grid.Column="1"
                                 Height="60"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding Detail.Note, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource txtGeneral}"/>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">
            <Button Name="btnConfirm"
            Content="Confirm"
            MinWidth="110"
            Height="36"
            Cursor="Hand"
            Style="{StaticResource btnConfirm}"
            Command="{Binding BookBtnConfirmClickCmd}" />
            <Button Name="btnCancel"
            Content="Cancel"
            MinWidth="100"
            Height="36"
            Margin="10,0,0,0"
            Cursor="Hand"
            Style="{StaticResource btnCancel}"
            Command="{Binding BookBtnCancelClickCmd}"/>
        </StackPanel>
    </Grid>
</UserControl>
