<UserControl x:Class="AnhQuoc_C5_Assignment.ucBookCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnhQuoc_C5_Assignment"
             mc:Ignorable="d" 
             HorizontalAlignment="Stretch"
             Name="YourUserControl">
    <UserControl.Resources>
        <local:PriceFormatConverter x:Key="PriceFormatConverter" />
        <local:IdBookStatusToNameConverter x:Key="IdBookStatusToNameConverter" />

        <Storyboard x:Key="MouseEnterStoryboard">
            <DoubleAnimation Duration="0:0:0.300" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-5" />
        </Storyboard>

        <Storyboard x:Key="MouseLeaveStoryboard">
            <DoubleAnimation Duration="0:0:0.800" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" />
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UIElement.MouseEnter" SourceName="YourUserControl">
            <BeginStoryboard Storyboard="{StaticResource MouseEnterStoryboard}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="UIElement.MouseLeave" SourceName="YourUserControl">
            <BeginStoryboard Storyboard="{StaticResource MouseLeaveStoryboard}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>
    <Border x:Name="container"
                Style="{StaticResource bdCard}"
                Focusable="True"
                HorizontalAlignment="Stretch" 
                CornerRadius="10"
                Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content Area -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <!-- Book Cover Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Book Information Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rounded Cover Image -->
                <Border Grid.Column="0" 
                            Width="90" 
                            Height="120" 
                            CornerRadius="8" 
                            Margin="0,0,12,0"
                            VerticalAlignment="Top"
                            Background="#F0F0F0"
                            ClipToBounds="True">
                    <Image Source="{Binding Item.BookTitle.UrlImage}" 
                               Stretch="Fill" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Book Metadata -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <!-- Book Title -->
                    <TextBlock Text="{Binding Item.BookTitle.Name}" 
                                   FontWeight="Bold" 
                                   FontSize="15" 
                                   Foreground="#212529" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>

                    <!-- Publisher -->
                    <TextBlock Text="{Binding Item.Publisher.Name}" 
                                   FontSize="12" 
                                   Foreground="#8C9199" 
                                   Margin="0,0,0,6"/>

                    <!-- Description with Height Limit -->
                    <TextBlock Text="{Binding Item.BookTitle.Summary}" 
                                   FontSize="12" 
                                   Foreground="#4A4E54" 
                                   TextWrapping="Wrap" 
                                   TextTrimming="CharacterEllipsis" 
                                   MaxHeight="80"
                                   LineHeight="16"/>
                </StackPanel>
            </Grid>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="1" 
                            Name="stkWrapButton"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="Visible">
                <Button Name="btnInfo"
                            Style="{StaticResource btnInfo}"
                            Content="More Info"
                            FontSize="12"/>
                <Button Name="btnDelete"
                            Style="{StaticResource btnDelete}"
                            Content="Delete"
                            FontSize="12"
                            Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>