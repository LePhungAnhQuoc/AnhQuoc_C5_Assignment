<Window x:Class="AnhQuoc_C5_Assignment.frmLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnhQuoc_C5_Assignment"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Style="{StaticResource wdStyleGeneral}"
        SizeToContent="Height" 
        Width="400"
        WindowStartupLocation="{StaticResource WSL}">
    <Window.Resources>
        <local:PasswordTextConverter x:Key="PasswordTextConverter" />
        <System:Double x:Key="TextFontSize">16.0</System:Double>
    </Window.Resources>
    <!-- Outer gradient background and centered white card -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8A2BE2" Offset="0"/>
                <GradientStop Color="#FF5ACD" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="White"
                CornerRadius="22"
                Width="420"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Login"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#222"
                           HorizontalAlignment="Center"
                           Margin="0 10 0 20" />

                <!-- Username -->
                <TextBlock Text="Username"
                           Style="{StaticResource tblGeneral}"
                           Foreground="#666"
                           FontSize="13"
                           Margin="6 0 0 6"/>
                <Grid Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- User icon using Path for crisp rendering -->
                    <Viewbox Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,12 C14.761,12 17,9.761 17,7 C17,4.239 14.761,2 12,2 C9.239,2 7,4.239 7,7 C7,9.761 9.239,12 12,12 Z M4,20 C4,16.686 7.134,14 12,14 C16.866,14 20,16.686 20,20 L4,20 Z"
                                  Fill="#999" Stretch="Uniform"/>
                        </Canvas>
                    </Viewbox>
                    <TextBox Grid.Column="1"
                             Name="txtUsername"
                             Style="{StaticResource txtUnderlineBorder}"
                             FontSize="16"
                             Tag="Type your username"
                             Foreground="#666"
                             TabIndex="0"
                             Validation.ErrorTemplate="{StaticResource txtErrorTemplate1}"
                             Text="{Binding Account.Username, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Password -->
                <TextBlock Text="Password"
                           Style="{StaticResource tblGeneral}"
                           Foreground="#666"
                           FontSize="13"
                           Margin="6 0 0 6"/>
                <Grid Margin="0 0 0 6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M17,8 L7,8 C6.447,8 6,8.447 6,9 L6,18 C6,18.553 6.447,19 7,19 L17,19 C17.553,19 18,18.553 18,18 L18,9 C18,8.447 17.553,8 17,8 Z M12,11 C13.105,11 14,11.895 14,13 C14,14.105 13.105,15 12,15 C10.895,15 10,14.105 10,13 C10,11.895 10.895,11 12,11 Z"
                                  Fill="#999" Stretch="Uniform"/>
                        </Canvas>
                    </Viewbox>
                    <PasswordBox Grid.Column="1"
                                 Name="boxPassword"
                                 Style="{StaticResource txtUnderlineBorder}"
                                 FontSize="16"
                                 Tag="Type your password"
                                 TabIndex="1"
                                 Validation.ErrorTemplate="{StaticResource txtErrorTemplate1}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 0 10">
                    <TextBlock x:Name="tblForgetPass"
                               Style="{StaticResource tblDisplayInfoLink}"
                               FontSize="14"
                               Text="Forgot password?"
                               Foreground="#a6a6a6"
                               MouseLeftButtonDown="tblForgetPass_MouseLeftButtonDown" />
                </StackPanel>

                <!-- Login Button -->
                <Button Name="btnSignIn"
                        TabIndex="2"
                        Height="44"
                        Margin="0 10"
                        HorizontalAlignment="Stretch"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="SemiBold">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6EE7F3" Offset="0" />
                            <GradientStop Color="#FF66CC" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="22" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="LOGIN"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Social -->
                <TextBlock Text="Or Sign Up Using" Foreground="#777" HorizontalAlignment="Center" Margin="0 14 0 8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="44" Height="44" Background="#3b5998" BorderThickness="0" Foreground="White" FontWeight="Bold" Margin="6,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="22" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Width="20" Height="20">
                            <Path Data="{StaticResource icon_facebook}" Fill="White" Stretch="Uniform" />
                        </Viewbox>
                    </Button>

                    <Button Width="44" Height="44" Background="#1DA1F2" BorderThickness="0" Foreground="White" FontWeight="Bold" Margin="6,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="22" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Width="20" Height="20">
                            <Path Data="{StaticResource icon_twitter}" Fill="White" Stretch="Uniform" />
                        </Viewbox>
                    </Button>

                    <Button Width="44" Height="44" Background="#DB4437" BorderThickness="0" Foreground="White" FontWeight="Bold" Margin="6,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="22" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Width="20" Height="20">
                            <Path Data="{StaticResource icon_google}" Fill="White" Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- Sign up link -->
                <StackPanel Margin="0 24 0 0" HorizontalAlignment="Center">
                    <TextBlock Text="Or Sign Up Using" Foreground="#777" HorizontalAlignment="Center" />
                    <TextBlock Text="SIGN UP" Style="{StaticResource tblDisplayInfoLink}" Margin="0 8 0 0" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>