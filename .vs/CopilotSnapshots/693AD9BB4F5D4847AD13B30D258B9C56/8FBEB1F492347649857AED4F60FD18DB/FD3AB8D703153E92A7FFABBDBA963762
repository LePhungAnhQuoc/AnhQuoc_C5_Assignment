<UserControl x:Class="AnhQuoc_C5_Assignment.ucInputBookInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnhQuoc_C5_Assignment"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900"
             x:Name="myUserControl">
    <UserControl.Resources>
        <!-- Reusable Style for Hovering Book Cards -->
        <Style x:Key="BookCardHoverStyle" TargetType="Border">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect x:Name="CardGlow" 
                                  BlurRadius="10" 
                                  ShadowDepth="2" 
                                  Opacity="0.3" 
                                  Color="Black"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Mouse Enter: Zoom & Glow -->
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" 
                                         To="1.05" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" 
                                         To="1.05" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.BlurRadius)" 
                                         To="25" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.ShadowDepth)" 
                                         To="0" Duration="0:0:0.2"/>
                            <ColorAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.Color)" 
                                        To="#FFD700" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)" 
                                         To="0.8" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- Mouse Leave: Reset -->
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" 
                                         To="1.0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" 
                                         To="1.0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.BlurRadius)" 
                                         To="10" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.ShadowDepth)" 
                                         To="2" Duration="0:0:0.2"/>
                            <ColorAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.Color)" 
                                        To="Black" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)" 
                                         To="0.3" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Soft Drop Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="15" 
                          ShadowDepth="4" 
                          Direction="270" 
                          Color="#000000" 
                          Opacity="0.12"/>

        <DropShadowEffect x:Key="SoftShadow" 
                          BlurRadius="10" 
                          ShadowDepth="2" 
                          Direction="270" 
                          Color="#000000" 
                          Opacity="0.08"/>

        <!-- Rounded Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C3F3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Background Panel with Soft Curved Bottom Right -->
        <Border Grid.Row="0" Background="#E6E3D3" Height="260" VerticalAlignment="Top">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,2000,260" RadiusX="0" RadiusY="0"/>
            </Border.Clip>
        </Border>

        <!-- Main Content Layout -->
        <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,30,40,30">

                <!-- Header Bar: Profile & Notifications -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Discover" FontSize="32" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center"/>

                    <!-- User Profile & Notification -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- User Avatar -->
                        <Border Width="36" Height="36" CornerRadius="18" Background="#A0B092" Margin="0,0,10,0">
                            <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Davis Workman ∨" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#333333" Margin="0,0,20,0"/>

                        <!-- Notification Icon with Red Dot -->
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="🔔" FontSize="16" Foreground="#333333"/>
                            <Ellipse Width="6" Height="6" Fill="#E74C3C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,1,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Search Bar Container -->
                <Border Background="White" CornerRadius="12" Padding="6" Width="480" HorizontalAlignment="Left" Effect="{StaticResource SoftShadow}" Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category Selector -->
                        <ComboBox Grid.Column="0" Text="All Categories" IsEditable="True" IsReadOnly="True" 
                                  BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Foreground="#555555"/>

                        <Rectangle Grid.Column="1" Fill="#E0E0E0" Margin="0,4"/>

                        <!-- Search Input -->
                        <TextBox Grid.Column="2" Text="🔍 Find the book you like...." Foreground="#888888" 
                                 BorderThickness="0" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>

                        <!-- Search Button -->
                        <Button Grid.Column="3" Content="Search" Style="{StaticResource DarkButtonStyle}" Padding="20,8"/>
                    </Grid>
                </Border>

                <!-- Book Recommendation Section -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Book Recommendation" FontSize="20" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"/>
                    <Button Content="View all >" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" Padding="15,6" Effect="{StaticResource SoftShadow}"/>
                </Grid>

                <!-- Recommendation Book Cards Carousel/Grid -->
                <UniformGrid Columns="4" Margin="0,10,0,40">
                    <!-- Book 1 -->
                    <Border Style="{StaticResource BookCardHoverStyle}">
                        <Border CornerRadius="16" ClipToBounds="True">
                            <Image Source="https://m.media-amazon.com/images/I/71jLBXtWJWL._AC_UF1000,1000_QL80_.jpg" Stretch="UniformToFill" Height="260"/>
                        </Border>
                    </Border>

                    <!-- Book 2 -->
                    <Border Margin="10" CornerRadius="16" Effect="{StaticResource CardShadow}">
                        <Border CornerRadius="16" ClipToBounds="True">
                            <Image Source="https://m.media-amazon.com/images/I/71jLBXtWJWL._AC_UF1000,1000_QL80_.jpg" Stretch="UniformToFill" Height="260"/>
                        </Border>
                    </Border>

                    <!-- Book 3 -->
                    <Border Margin="10" CornerRadius="16" Effect="{StaticResource CardShadow}">
                        <Border CornerRadius="16" ClipToBounds="True">
                            <Image Source="https://m.media-amazon.com/images/I/71jLBXtWJWL._AC_UF1000,1000_QL80_.jpg" Stretch="UniformToFill" Height="260"/>
                        </Border>
                    </Border>

                    <!-- Book 4 -->
                    <Border Margin="10" CornerRadius="16" Effect="{StaticResource CardShadow}">
                        <Border CornerRadius="16" ClipToBounds="True">
                            <Image Source="https://m.media-amazon.com/images/I/81MbgS5fI3L._AC_UF1000,1000_QL80_.jpg" Stretch="UniformToFill" Height="260"/>
                        </Border>
                    </Border>
                </UniformGrid>

                <!-- Book Category Section Header -->
                <Grid Margin="0,0,0,15">
                    <TextBlock Text="Book Category" FontSize="20" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1">
                        <TextBlock Text="🎛️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>
                </Grid>

                <!-- Category Cards Row -->
                <UniformGrid Columns="4">
                    <!-- Category 1 -->
                    <StackPanel Margin="10">
                        <Grid Height="140">
                            <!-- Background Pill Block -->
                            <Border Background="#F4F4F4" CornerRadius="12" Height="70" VerticalAlignment="Bottom"/>
                            <!-- Overlapping Book Cover -->
                            <Border Width="100" Height="130" CornerRadius="8" Effect="{StaticResource SoftShadow}" VerticalAlignment="Top" HorizontalAlignment="Center">
                                <Border CornerRadius="8" ClipToBounds="True">
                                    <Image Source="https://m.media-amazon.com/images/I/71jLBXtWJWL._AC_UF1000,1000_QL80_.jpg" Stretch="UniformToFill"/>
                                </Border>
                            </Border>
                        </Grid>
                        <TextBlock Text="Money/Investing" TextAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" Foreground="#222222"/>
                    </StackPanel>

                    <!-- Category 2 -->
                    <StackPanel Margin="10">
                        <Grid Height="140">
                            <Border Background="#F4F4F4" CornerRadius="12" Height="70" VerticalAlignment="Bottom"/>
                            <Border Width="100" Height="130" CornerRadius="8" Effect="{StaticResource SoftShadow}" VerticalAlignment="Top" HorizontalAlignment="Center">
                                <Border CornerRadius="8" ClipToBounds="True">
                                    <Image Source="https://m.media-amazon.com/images/I/91N1eO7fcdL._AC_UF1000,1000_QL80_.jpg" Stretch="UniformToFill"/>
                                </Border>
                            </Border>
                        </Grid>
                        <TextBlock Text="Design" TextAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" Foreground="#222222"/>
                    </StackPanel>

                    <!-- Category 3 -->
                    <StackPanel Margin="10">
                        <Grid Height="140">
                            <Border Background="#F4F4F4" CornerRadius="12" Height="70" VerticalAlignment="Bottom"/>
                            <Border Width="100" Height="130" CornerRadius="8" Effect="{StaticResource SoftShadow}" VerticalAlignment="Top" HorizontalAlignment="Center">
                                <Border CornerRadius="8" ClipToBounds="True">
                                    <Image Source="https://m.media-amazon.com/images/I/71x52a0aKLL._AC_UF1000,1000_QL80_.jpg" Stretch="UniformToFill"/>
                                </Border>
                            </Border>
                        </Grid>
                        <TextBlock Text="Business" TextAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" Foreground="#222222"/>
                    </StackPanel>

                    <!-- Category 4 -->
                    <StackPanel Margin="10">
                        <Grid Height="140">
                            <Border Background="#F4F4F4" CornerRadius="12" Height="70" VerticalAlignment="Bottom"/>
                            <Border Width="100" Height="130" CornerRadius="8" Effect="{StaticResource SoftShadow}" VerticalAlignment="Top" HorizontalAlignment="Center">
                                <Border CornerRadius="8" ClipToBounds="True">
                                    <Image Source="https://m.media-amazon.com/images/I/71QKQ9mwV7L._AC_UF1000,1000_QL80_.jpg" Stretch="UniformToFill"/>
                                </Border>
                            </Border>
                        </Grid>
                        <TextBlock Text="Self Improvement" TextAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" Foreground="#222222"/>
                    </StackPanel>
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>