<Window x:Class="AnhQuoc_C5_Assignment.frmLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnhQuoc_C5_Assignment"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Style="{StaticResource wdStyleGeneral}"
        SizeToContent="Height" 
        Width="400"
        WindowStartupLocation="{StaticResource WSL}">
    <Window.Resources>
        <local:PasswordTextConverter x:Key="PasswordTextConverter" />
        <System:Double x:Key="TextFontSize">16.0</System:Double>
    </Window.Resources>
    <!-- Outer gradient background and centered white card -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8A2BE2" Offset="0"/>
                <GradientStop Color="#FF5ACD" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="White"
                CornerRadius="12"
                Width="420"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Login"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#222"
                           HorizontalAlignment="Center"
                           Margin="0 10 0 20" />

                <!-- Username -->
                <TextBlock Text="Username"
                           Style="{StaticResource tblGeneral}"
                           Foreground="#666"
                           Margin="6 0 0 6"/>
                <Grid Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="👤" VerticalAlignment="Center" FontSize="16" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Name="txtUsername"
                             Style="{StaticResource txtUnderlineBorder}"
                             FontSize="16"
                             Tag="Type your username"
                             TabIndex="0"
                             Validation.ErrorTemplate="{StaticResource txtErrorTemplate1}"
                             Text="{Binding Account.Username, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Password -->
                <TextBlock Text="Password"
                           Style="{StaticResource tblGeneral}"
                           Foreground="#666"
                           Margin="6 0 0 6"/>
                <Grid Margin="0 0 0 6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔒" VerticalAlignment="Center" FontSize="16" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Name="boxPassword"
                             Style="{StaticResource txtUnderlineBorder}"
                             FontSize="16"
                             Tag="Type your password"
                             TabIndex="1"
                             Validation.ErrorTemplate="{StaticResource txtErrorTemplate1}"
                             Foreground="Transparent"
                             Text="{Binding Account.Password, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1" Text="" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 0 10">
                    <TextBlock x:Name="tblForgetPass"
                               Style="{StaticResource tblDisplayInfoLink}"
                               FontSize="14"
                               Text="Forgot password?"
                               Foreground="#a6a6a6"
                               MouseLeftButtonDown="tblForgetPass_MouseLeftButtonDown" />
                </StackPanel>

                <!-- Login Button -->
                <Button Name="btnSignIn"
                        TabIndex="2"
                        Height="44"
                        Margin="0 10"
                        HorizontalAlignment="Stretch"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="SemiBold">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6EE7F3" Offset="0" />
                            <GradientStop Color="#FF66CC" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="22" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="LOGIN"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Social -->
                <TextBlock Text="Or Sign Up Using" Foreground="#777" HorizontalAlignment="Center" Margin="0 14 0 8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="44" Height="44" Background="#3b5998" BorderThickness="0" Content="f" Foreground="White" FontWeight="Bold"/>
                    <Button Width="44" Height="44" Background="#1DA1F2" BorderThickness="0" Content="t" Foreground="White" FontWeight="Bold"/>
                    <Button Width="44" Height="44" Background="#DB4437" BorderThickness="0" Content="G" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <!-- Sign up link -->
                <StackPanel Margin="0 24 0 0" HorizontalAlignment="Center">
                    <TextBlock Text="Or Sign Up Using" Foreground="#777" HorizontalAlignment="Center" />
                    <TextBlock Text="SIGN UP" Style="{StaticResource tblDisplayInfoLink}" Margin="0 8 0 0" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>