<UserControl x:Class="AnhQuoc_C5_Assignment.ucRetureBookInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnhQuoc_C5_Assignment"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             mc:Ignorable="d" 
             d:DesignWidth="800"
             x:Name="myUserControl">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding BookLoadedCmd}" 
                                   CommandParameter="{Binding ElementName=myUserControl}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <UserControl.Resources>
        <local:PriceFormatConverter x:Key="PriceFormatConverter" />
        <local:BindingProxy x:Key="proxy" Data="{Binding}"/>
        <Style x:Key="txtGeneral" TargetType="TextBox" BasedOn="{StaticResource txtLightBorder}">
            <Setter Property="Width" Value="auto" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Name="gdInputLoanHistory"
          Style="{StaticResource gdContainerForUserControl}"
          Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Add New Loan History"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="#1A1A1A"
                   Margin="0,0,0,15" HorizontalAlignment="Left" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="#3968b4">
                    <Label Style="{StaticResource lblTitleStyleInBar}"
                           Content="List book of reader" />
                </Grid>
                <ScrollViewer Grid.Row="1"
                              Style="{StaticResource scrollStyleContainWrap}"
                              VerticalAlignment="Stretch">
                    <WrapPanel Name="wrapUnPaidBooksTable"
                               HorizontalAlignment="Stretch">
                    </WrapPanel>
                </ScrollViewer>
            </Grid>

            <GroupBox Grid.Column="1" FontSize="15" Padding="12" Margin="0,0,0,15" Header="Return Details">
                <Grid>
                    <Grid.Resources>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="0,4" />
                        </Style>
                        <Style TargetType="Label" BasedOn="{StaticResource lblGeneral}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Reader:" />
                        <TextBox Name="txtReaderName" Grid.Column="1" Style="{StaticResource txtGeneral}"
                                 Text="{Binding SelectedReader.FullName, Mode=OneWay}" IsEnabled="False" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Loan ID:" />
                        <TextBox Name="txtIdLoan" Grid.Column="1" Style="{StaticResource txtGeneral}"
                                 Text="{Binding SelectedLoanSlip.Id, Mode=OneWay}" IsEnabled="False" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Reason:" />
                        <Grid Grid.Column="1">
                            <ComboBox Name="cbTxtReason" Style="{StaticResource cbGeneral}" DisplayMemberPath="Name">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="DropDownClosed">
                                        <i:InvokeCommandAction Command="{Binding BookcbTxtReasonDropDownClosedCmd}"
                                                                   CommandParameter="{Binding ElementName=cbTxtReason}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding BookcbTxtReasonSelectionChangedCmd}"
                                                                   CommandParameter="{Binding ElementName=cbTxtReason}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ComboBox>
                            <TextBox Name="txtReason" Grid.Column="0" Style="{StaticResource txtGeneral}"
                                     Validation.ErrorTemplate="{StaticResource txtErrorTemplate1}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="TextChanged">
                                        <i:InvokeCommandAction Command="{Binding BooktxtReasonTextChangedCmd}"
                                                                   CommandParameter="{Binding ElementName=txtReason}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <TextBox.Text>
                                    <Binding Path="InputReason" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:InputUnicodeTextNumberRule />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Fine amount:" />
                        <Grid Grid.Column="1">
                            <TextBox Name="txtFineAmount" Style="{StaticResource txtGeneral}"
                                     Validation.ErrorTemplate="{StaticResource txtErrorTemplate1}"
                                     IsEnabled="False" Foreground="Transparent">
                                <TextBox.Text>
                                    <Binding Path="Detail.PaidMoney" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:InputNumberRule />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <TextBlock Style="{StaticResource tblPriceFormat}">
                                <TextBlock.Text>
                                    <Binding Path="Detail.PaidMoney" UpdateSourceTrigger="PropertyChanged"
                                             Converter="{StaticResource PriceFormatConverter}" />
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Note:" />
                        <TextBox Name="txtNote" Grid.Column="1" Style="{StaticResource txtGeneral}"
                                 Validation.ErrorTemplate="{StaticResource txtErrorTemplate1}">
                            <TextBox.Text>
                                <Binding Path="Detail.Note" UpdateSourceTrigger="PropertyChanged" />
                            </TextBox.Text>
                        </TextBox>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Footer & Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtErrorMessage"
                       Grid.Column="0"
                       Style="{StaticResource tblErrorMessage}"
                       Text="{Binding InvalidMessage}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <StackPanel Margin="10 0 0 0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnConfirm" Content="Confirm"
                        Width="100" Height="32"
                        Margin="0,0,10,0"
                        Style="{StaticResource btnConfirm}"
                        Command="{Binding BookBtnConfirmClickCmd}" />
                <Button Name="btnCancel" Content="Cancel" 
                        Width="100" Height="32"
                        Style="{StaticResource btnCancel}"
                        Command="{Binding BookBtnCancelClickCmd}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
